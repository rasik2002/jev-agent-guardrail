{
  "version": "v1",
  "hooks": [
    {
      "name": "Run tests on Python save",
      "trigger": "PostFileSave",
      "matcher": "\\.py$",
      "action": { "type": "command", "command": "python -m pytest -q" }
    },
    {
      "name": "Lint SAM template on save",
      "trigger": "PostFileSave",
      "matcher": "template\\.yaml$",
      "action": { "type": "command", "command": "sam validate --lint" }
    }
  ]
}
